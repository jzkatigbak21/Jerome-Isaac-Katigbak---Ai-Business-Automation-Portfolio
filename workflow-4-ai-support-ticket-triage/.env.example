ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-5
MAX_CONCURRENT_REQUESTS=5

# Only needed for --source gorgias
GORGIAS_SUBDOMAIN=your-store-subdomain
GORGIAS_EMAIL=your-gorgias-login-email
GORGIAS_API_KEY=your-gorgias-api-key

# Only needed for the webhook receiver (src/webhook_server.py). Optional --
# if unset, the webhook accepts requests without checking a shared secret.
WEBHOOK_SECRET=choose-a-random-string

# Optional. If set, urgent flagged tickets (high urgency + needs_human_review)
# post a ping to this Slack Incoming Webhook URL. If unset, notify_slack()
# is a no-op -- Slack is never required for the pipeline to work.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
